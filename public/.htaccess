RewriteEngine On

# The old "How to pay" address now lives on the Support page
RewriteRule ^pay/?$ /support/#pay [R=301,NE,L]

# Always use the www address
RewriteCond %{HTTP_HOST} ^maranet\.co\.ke$ [NC]
RewriteRule ^ https://www.maranet.co.ke%{REQUEST_URI} [L,R=301]

# Always use the secure (https) address
RewriteCond %{HTTPS} off
RewriteRule ^ https://%{HTTP_HOST}%{REQUEST_URI} [L,R=301]

# Show the site's own "page not found" page
ErrorDocument 404 /404.html